# =============================================================================
# ARDUINIUM — environment
# =============================================================================
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit a
# real key. See README §"Setting up the backend" for where each value comes
# from.
#
# The site runs with NONE of these set: lessons, the 3D sandbox, the landing
# page and the local-storage version of progress and community posts all work.
# What each variable switches on is noted below.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Both of these are safe in a browser bundle — the anon key is only ever as
# powerful as the RLS policies in supabase/migrations/0002_rls.sql allow.
# Without them: accounts, real progress, /admin and the AI assistant are off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses every RLS policy — treat it like a database password.
# Used by `node supabase/seed.mjs` and by the AI route when writing a
# transcript. Never prefix it with NEXT_PUBLIC_, and never expose it to a client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI assistant ------------------------------------------------------------
# Server-only, used by app/api/ai/chat/route.ts. Without it, /ai and the
# sandbox's Ardu button say "not configured" rather than failing at runtime.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low
# ANTHROPIC_MAX_TOKENS=1600

# Messages per user per day. Cost control and abuse control at once.
# AI_DAILY_MESSAGE_LIMIT=30

# --- Seed script -------------------------------------------------------------
# Password given to every demo account created by supabase/seed.mjs.
# SEED_PASSWORD=arduinium-demo
